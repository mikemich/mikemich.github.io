---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

type Props = { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> };

const { project, next } = Astro.props;
const { title, summary, year, context, tags, cover, link, repo, highlights } = project.data;
const meta = [context, year].filter(Boolean).join(' · ');
const { Content } = await render(project);
---

<Base title={title} description={summary} current="projects">
  <article class="container project">
    <a class="back" href="/#projects"><Icon name="arrow-left" size={20} /> All projects</a>

    <header class="project-header">
      {meta && <span class="eyebrow">{meta}</span>}
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )}
      {
        (link || repo) && (
          <div class="actions">
            {link && (
              <a href={link} target="_blank" rel="noopener noreferrer">
                Visit site <Icon name="external" size={18} />
              </a>
            )}
            {repo && (
              <a href={repo} target="_blank" rel="noopener noreferrer">
                <Icon name="github" size={18} /> Source code
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      cover && (
        <div class="cover">
          <Image src={cover} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1760px) 100vw, 1604px" loading="eager" />
        </div>
      )
    }

    {
      highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      next.id !== project.id && (
        <a class="next" href={`/projects/${next.id}`}>
          <span class="eyebrow">Next project</span>
          <span class="next-title">
            {next.data.title} <Icon name="arrow" size={32} />
          </span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .project {
    padding-top: clamp(48px, 6vw, 120px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 16px;
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--accent);
  }

  .project-header {
    margin-top: clamp(32px, 4vw, 64px);
    max-width: 1056px;
  }

  h1 {
    font-size: clamp(40px, 1.5rem + 3vw, 72px);
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .summary {
    margin-top: 20px;
    font-size: clamp(20px, 1.4vw, 26px);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 50ch;
  }

  .tags {
    margin-top: 28px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 28px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-decoration: none;
  }

  .actions a:hover {
    text-decoration: underline;
  }

  .cover {
    margin-top: clamp(40px, 5vw, 80px);
    background: var(--surface);
  }

  .cover :global(img) {
    width: 100%;
  }

  .highlights {
    list-style: none;
    margin: clamp(40px, 5vw, 72px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .highlights li {
    background: var(--bg);
    padding: 24px;
    font-size: 17px;
    line-height: 1.45;
    border-top: 2px solid var(--accent);
  }

  .prose {
    margin-top: clamp(40px, 4vw, 64px);
  }

  .next {
    display: block;
    margin-top: clamp(80px, 9vw, 160px);
    padding-top: 40px;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .next-title {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-size: clamp(28px, 2.6vw, 48px);
    font-weight: 300;
  }

  .next-title :global(svg) {
    color: var(--accent);
    transition: transform 0.2s;
  }

  .next:hover .next-title :global(svg) {
    transform: translateX(6px);
  }
</style>
