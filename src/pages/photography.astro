---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photos } from '../data/photos';

// A larger version of each photo for the full-screen viewer.
const items = await Promise.all(
  photos.map(async (photo) => ({
    ...photo,
    full: (await getImage({ src: photo.src, width: Math.min(photo.src.width, 2400), format: 'webp' })).src,
  })),
);
---

<Base title="Photography" description="Photography by Michalis Michalopoulos." current="photography">
  <section class="container gallery-page">
    <h1>Photography</h1>
    <p class="intro muted">Things I've seen through the lens.</p>

    {
      items.length > 0 ? (
        <ul class="gallery">
          {items.map((photo, i) => (
            <li>
              <button type="button" class="photo" data-index={i} data-full={photo.full} data-caption={photo.caption}>
                <Image
                  src={photo.src}
                  alt={photo.caption || `Photo ${i + 1}`}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
                />
              </button>
              {photo.caption && <p class="caption">{photo.caption}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>The gallery is on its way.</p>
        </div>
      )
    }
  </section>

  <dialog class="viewer" aria-label="Photo viewer">
    <button type="button" class="viewer-btn close" aria-label="Close">×</button>
    <button type="button" class="viewer-btn prev" aria-label="Previous photo">‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="viewer-btn next" aria-label="Next photo">›</button>
  </dialog>
</Base>

<style>
  .gallery-page {
    padding-top: clamp(48px, 6vw, 120px);
  }

  h1 {
    font-size: clamp(40px, 1.5rem + 3vw, 72px);
    font-weight: 300;
  }

  .intro {
    margin-top: 16px;
    font-size: 20px;
  }

  /* Masonry-style columns keep each photo's natural aspect ratio. */
  .gallery {
    list-style: none;
    margin: clamp(40px, 5vw, 80px) 0 0;
    padding: 0;
    columns: 3 320px;
    column-gap: 16px;
  }

  .gallery li {
    break-inside: avoid;
    margin-bottom: 16px;
  }

  /* With JS, photos are dealt into columns in order (left to right), shortest column first. */
  .gallery.js-masonry {
    columns: auto;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .gallery.js-masonry > :global(.col) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .photo {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    cursor: zoom-in;
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    transition: transform 0.4s ease, opacity 0.3s;
  }

  .photo:hover :global(img) {
    transform: scale(1.03);
  }

  .caption {
    margin-top: 8px;
    font-size: 14px;
    color: var(--text-dim);
  }

  .empty {
    margin-top: clamp(40px, 5vw, 80px);
    aspect-ratio: 16 / 7;
    min-height: 240px;
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--text-muted);
    text-align: center;
    padding: 24px;
  }

  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(18, 18, 18, 0.96);
    color: var(--text);
  }

  .viewer[open] {
    display: grid;
    grid-template-columns: 64px 1fr 64px;
    align-items: center;
  }

  .viewer::backdrop {
    background: transparent;
  }

  figure {
    margin: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 56px 0 24px;
    min-width: 0;
  }

  figure img {
    max-width: 100%;
    max-height: calc(100dvh - 120px);
    object-fit: contain;
  }

  figcaption {
    color: var(--text-muted);
    font-size: 15px;
  }

  .viewer-btn {
    background: none;
    border: 0;
    color: var(--text);
    font-size: 44px;
    line-height: 1;
    cursor: pointer;
    padding: 12px;
    opacity: 0.7;
    transition: opacity 0.2s, color 0.2s;
  }

  .viewer-btn:hover {
    opacity: 1;
    color: var(--accent);
  }

  .close {
    position: absolute;
    top: 8px;
    right: 12px;
  }

  @media (max-width: 700px) {
    .viewer[open] {
      grid-template-columns: 40px 1fr 40px;
    }

    .viewer-btn {
      font-size: 34px;
      padding: 6px;
    }
  }
</style>

<script>
  // Row-major masonry: CSS columns fill top-to-bottom, which would push the first photos
  // down the first column. Deal them into columns in order instead.
  const gallery = document.querySelector<HTMLUListElement>('.gallery');
  if (gallery) {
    const items = [...gallery.children] as HTMLLIElement[];
    const ratio = (li: HTMLLIElement) => {
      const img = li.querySelector('img');
      const w = Number(img?.getAttribute('width')), h = Number(img?.getAttribute('height'));
      return w && h ? h / w : 1;
    };
    let current = 0;
    const layout = () => {
      const width = gallery.clientWidth;
      const n = width > 1000 ? 3 : width > 560 ? 2 : 1;
      if (n === current) return;
      current = n;
      gallery.classList.add('js-masonry');
      gallery.replaceChildren();
      const cols = Array.from({ length: n }, () => {
        const col = document.createElement('div');
        col.className = 'col';
        gallery.append(col);
        return { col, height: 0 };
      });
      for (const li of items) {
        const target = cols.reduce((a, b) => (b.height < a.height ? b : a));
        target.col.append(li);
        target.height += ratio(li) + 0.12; // + caption/gap
      }
    };
    layout();
    let t: number | undefined;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(layout, 150);
    });
  }

  const dialog = document.querySelector<HTMLDialogElement>('.viewer');
  // Keep the original order for next/previous, whatever column a photo ended up in.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.gallery .photo')].sort(
    (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
  );

  if (dialog && buttons.length) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + buttons.length) % buttons.length;
      const { full = '', caption: text = '' } = buttons[index].dataset;
      img.src = full;
      img.alt = text;
      caption.textContent = text;
    };

    buttons.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    dialog.addEventListener('close', () => buttons[index]?.focus());
  }
</script>
